---
import BaseLayout from './BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../config';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, image, tags } = post.data;

const postUrl = new URL(`/blog/${post.id}/`, Astro.site ?? SITE.url).toString();
const markdownPath = `/blog/${post.id}.md`;
const ogImage = image ?? SITE.ogImage;
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).toString();

// schema.org structured data so search engines and AI agents can parse the post.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: ogImageUrl,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author, sameAs: SITE.sameAs },
  publisher: { '@type': 'Organization', name: SITE.title },
  keywords: tags.join(', '),
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};

// Breadcrumb trail for rich results in search engines.
const siteOrigin = (Astro.site ?? new URL(SITE.url)).origin;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteOrigin}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  structuredData={[structuredData, breadcrumb]}
  markdownPath={markdownPath}
  ogType="article"
  image={ogImage}
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
>
  <Header />
  <main>
    <article class="container">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span>· Updated <FormattedDate date={updatedDate} /></span>
            )
          }
        </div>
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => (
                <a class="tag" href={`/tags/${tag}/`}>
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>
      {
        image && (
          <img class="hero" src={image} alt={title} width="1200" height="630" />
        )
      }
      <div class="prose">
        <slot />
      </div>
      <hr />
      <a href="/blog/" class="back">← Back to all posts</a>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .post-header h1 {
    margin-bottom: 0.5rem;
  }
  .hero {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0 0.5rem;
  }
  .post-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .tag {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .back {
    font-size: 0.95rem;
  }
</style>
