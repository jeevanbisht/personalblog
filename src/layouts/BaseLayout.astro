---
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path for canonical/OG URL. */
  path?: string;
  /** Optional schema.org JSON-LD object emitted for crawlers and AI agents. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Optional URL to a raw Markdown version of this page (for AI agents). */
  markdownPath?: string;
  /** OG/Twitter type. Use 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** Root-relative or absolute social-share image. Falls back to site default. */
  image?: string;
  /** Article metadata, emitted only when ogType is 'article'. */
  publishedTime?: string;
  modifiedTime?: string;
  /** When true, ask search engines not to index this page (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  structuredData,
  markdownPath,
  ogType = 'website',
  image = SITE.ogImage,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const siteOrigin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(path, siteOrigin).toString();
const ogImage = new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      markdownPath && (
        <link
          rel="alternate"
          type="text/markdown"
          href={markdownPath}
          title="Markdown version"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      ogType === 'article' && (
        <>
          {publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
          )}
          {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
          )}
          <meta property="article:author" content={SITE.author} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      structuredData &&
        (Array.isArray(structuredData) ? structuredData : [structuredData]).map(
          (data) => (
            <script
              type="application/ld+json"
              set:html={JSON.stringify(data)}
            />
          )
        )
    }

    <!-- Set theme before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
