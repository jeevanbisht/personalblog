---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../layouts/Header.astro';
import Footer from '../layouts/Footer.astro';
import { SITE } from '../config';
---

<BaseLayout
  title="About"
  description={`About ${SITE.author} — writing on identity, network access, security, and AI.`}
>
  <Header />
  <main>
    <section class="container prose">
      <h1>About</h1>
      <p>
        Hi, I'm {SITE.author}. Welcome to my corner of the web. This is where I
        write about the things I'm building, learning, and thinking about.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
